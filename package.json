{
  "name": "time-counter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "turbo build",
    "build:pages": "pnpm run build && rm -rf dist && mkdir -p dist && cp -R apps/landing/dist/. dist/ && for app in apps/*; do app_name=$(basename \"$app\"); if [ \"$app_name\" = \"landing\" ]; then continue; fi; if [ -d \"$app/dist\" ]; then mkdir -p \"dist/$app_name\"; cp -R \"$app/dist/.\" \"dist/$app_name/\"; fi; done && touch dist/.nojekyll",
    "test:e2e": "pnpm --filter @time-calculator/e2e test"
  },
  "pnpm": {
    "overrides": {
      "cookie": "0.7.2",
      "uuid": "14.0.1",
      "webpack-dev-server": "5.2.6",
      "@hono/node-server": "2.0.10",
      "postcss": "8.5.24",
      "ip-address": "10.5.1",
      "qs": "6.16.0",
      "js-yaml": "5.4.1",
      "websocket-driver": "0.7.5",
      "shell-quote": "1.9.0",
      "hono": "4.13.5",
      "immutable": "5.1.8",
      "body-parser@^1": "1.20.6",
      "body-parser@^2": "2.3.0",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.7",
      "undici": "7.29.1",
      "nanoid": "3.3.18",
      "browserslist": "4.28.7",
      "baseline-browser-mapping": "2.11.0",
      "devalue": "5.9.2",
      "@humanfs/node": "0.16.8",
      "postcss-selector-parser@^7": "7.1.3"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-71330",
        "CVE-2025-71329"
      ]
    }
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  }
}

{
  "name": "time-counter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "turbo build",
    "build:pages": "pnpm run build && rm -rf dist && mkdir -p dist && cp -R apps/landing/dist/. dist/ && for app in apps/*; do app_name=$(basename \"$app\"); if [ \"$app_name\" = \"landing\" ]; then continue; fi; if [ -d \"$app/dist\" ]; then mkdir -p \"dist/$app_name\"; cp -R \"$app/dist/.\" \"dist/$app_name/\"; fi; done && touch dist/.nojekyll",
    "test:e2e": "pnpm --filter @time-calculator/e2e test",
    "test:security": "node --test tests/security/*.test.cjs"
  },
  "pnpm": {
    "overrides": {
      "uuid": "14.0.1",
      "webpack-dev-server": "5.2.6",
      "@hono/node-server": "2.0.10",
      "postcss": "8.5.24",
      "ip-address": "10.7.4",
      "qs": "6.16.0",
      "js-yaml": "5.4.1",
      "websocket-driver": "0.7.5",
      "shell-quote": "1.11.0",
      "hono": "4.13.11",
      "immutable": "5.1.8",
      "body-parser@^1": "1.20.9",
      "body-parser@^2": "2.4.0",
      "brace-expansion": "5.0.12",
      "fast-uri": "3.1.9",
      "undici": "7.30.1",
      "nanoid": "3.3.18",
      "browserslist": "4.28.7",
      "baseline-browser-mapping": "2.11.0",
      "@humanfs/node": "0.16.8",
      "postcss-selector-parser@^7": "7.1.6",
      "cookie@<1": "0.7.2",
      "@modelcontextprotocol/sdk": "1.32.0",
      "piscina": "5.3.2",
      "follow-redirects": "1.16.1",
      "compression": "1.8.2",
      "http-cache-semantics": "4.3.0",
      "source-map-js": "1.2.2",
      "proxy-addr": "2.0.8",
      "launch-editor": "2.14.2",
      "zod@^4": "4.6.6",
      "serialize-javascript": "7.1.3",
      "@angular/build>vite": "7.3.7",
      "devalue@^5": "5.9.4"
    },
    "patchedDependencies": {
      "http-cache-semantics@4.3.0": "patches/http-cache-semantics@4.3.0.patch"
    }
  },
  "devDependencies": {
    "http-cache-semantics": "4.3.0",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
